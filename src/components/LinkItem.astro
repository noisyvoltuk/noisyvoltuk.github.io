---
import type { CollectionEntry } from 'astro:content';
import { fmtDate, isoDate, youtubeId } from '../lib/content';
import Tags from './Tags.astro';
import YouTube from './YouTube.astro';
const { link } = Astro.props as { link: CollectionEntry<'links'> };
const { url, title, comment, date, tags } = link.data;
const yt = youtubeId(url);
const host = new URL(url).hostname.replace(/^www\./, '');
---
<article class="link" id={link.id}>
  <h3><a href={url} rel="noopener">{title}</a> <span class="host">{host}</span></h3>
  {yt && <YouTube id={yt} title={title} />}
  {comment && <p>{comment}</p>}
  <div class="foot">
    <time class="muted small" datetime={isoDate(date)}>{fmtDate(date)}</time>
    <Tags tags={tags} />
  </div>
</article>
<style>
  .link { padding: 1.1rem 0; border-top: 1px solid var(--border); }
  .link:first-child { border-top: 0; }
  h3 { margin: 0; font-size: 1.05rem; }
  .host { font-weight: 400; font-size: 0.8rem; color: var(--muted); margin-left: 0.25rem; }
  p { margin: 0.35rem 0; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .foot :global(.tags) { margin: 0; }
  .link :global(.yt) { max-width: 36rem; }
</style>
