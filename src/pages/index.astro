---
import Base from '../layouts/Base.astro';
import Stream from '../components/Stream.astro';
import { getAll } from '../lib/content';
import { PROFILES, FORUMS } from '../lib/site';

const profiles = PROFILES.filter((p) => p.url);
const forums = FORUMS.filter((f) => f.url);
// Synths, notes and music in one list, no dates. Links and riffs stay on their own pages.
const things = await getAll(['projects', 'notes', 'music']);
---
<Base>
  <section class="intro prose">
    <h1>Hi, I'm Andy.</h1>
    <p class="lede">I build synthesizers and make music with them, mostly in CSound.</p>
  </section>

  <ul class="profiles">
    {profiles.map((p) => <li><a href={p.url} rel="me noopener">{p.label}</a></li>)}
  </ul>

  {forums.length > 0 && (
    <section>
      <h2 class="label">Also found at</h2>
      <ul class="profiles small">
        {forums.map((f) => <li><a href={f.url} rel="me noopener">{f.label}</a></li>)}
      </ul>
    </section>
  )}

  {things.length > 0 && (
    <section class="prose">
      <h2 class="label">Now and then</h2>
      <Stream entries={things} showDate={false} />
    </section>
  )}
</Base>
<style>
  .intro { margin-bottom: 1.5rem; }
  .lede { font-size: 1.15rem; color: var(--muted); margin: 0; }
  .profiles { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; max-width: 30rem; }
  .profiles a {
    display: block; padding: 0.8rem 1rem; border: 1px solid var(--border); border-radius: var(--radius);
    color: var(--text); text-decoration: none; font-weight: 600;
  }
  .profiles a:hover { border-color: var(--accent); color: var(--accent); }
  .profiles.small a { padding: 0.55rem 1rem; font-weight: 500; font-size: 0.95rem; }
  .label { margin: 2.75rem 0 0.75rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
</style>
