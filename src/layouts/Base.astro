---
import '../styles/global.css';
import { SITE, SECTIONS } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  rss?: { href: string; title: string };
}
const { title, description = SITE.description, image, rss } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title}: everything`} href="/rss.xml" />
    {rss && <link rel="alternate" type="application/rss+xml" title={rss.title} href={rss.href} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true"><path d="M2 16h5l3-9 5 18 4-14 3 5h8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {SITE.title}
        </a>
        <nav aria-label="Main">
          <ul>
            {SECTIONS.map((s) => (
              <li><a href={s.href} aria-current={path.startsWith(s.href) ? 'page' : undefined}>{s.label}</a></li>
            ))}
          </ul>
        </nav>
        <button class="theme" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" fill="currentColor"/></svg>
        </button>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <p>© {new Date().getFullYear()} {SITE.author} · <a href={SITE.github}>GitHub</a> · <a href="/rss.xml">RSS</a> · <a href="/feeds/">All feeds</a></p>
    </footer>
    <script is:inline>
      document.querySelector('.theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--bg); padding: 0.4rem 0.8rem; z-index: 10; }
  .site-header { border-bottom: 1px solid var(--border); margin-bottom: 2.5rem; }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 3.75rem; flex-wrap: wrap; padding-top: 0.4rem; padding-bottom: 0.4rem; }
  .brand { display: flex; align-items: center; gap: 0.45rem; font-weight: 700; color: var(--text); text-decoration: none; letter-spacing: -0.01em; }
  .brand svg { color: var(--accent); }
  nav { margin-left: auto; }
  nav ul { display: flex; flex-wrap: wrap; gap: 0.15rem 1rem; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.4em; text-decoration-thickness: 2px; }
  .theme { background: none; border: 1px solid var(--border); border-radius: 8px; color: var(--muted); padding: 0.35rem; cursor: pointer; display: grid; place-items: center; }
  .theme:hover { color: var(--text); }
  @media (max-width: 40rem) { nav { order: 3; width: 100%; margin-left: 0; } .theme { margin-left: auto; } }
  main { min-height: 60vh; }
  .site-footer { margin-top: 4rem; padding-top: 1.5rem; padding-bottom: 2rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.875rem; }
  .site-footer a { color: inherit; }
</style>
